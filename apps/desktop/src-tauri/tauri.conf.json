{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "DeskSpawn",
  "version": "0.5.1",
  "identifier": "com.deskspawn.app",
  "build": {
    "beforeDevCommand": "cd ../.. && pnpm --filter desktop dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../.. && pnpm --filter desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeskSpawn",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* tauri://localhost https:; frame-src 'self' http://localhost:*; object-src 'none'; base-uri 'self'; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/deskspawn-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null
    }
  }
}
