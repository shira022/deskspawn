{
  "identifier": "default",
  "description": "Default capabilities for DeskSpawn",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/deskspawn-sidecar",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/deskspawn-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}