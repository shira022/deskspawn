# DeskSpawn E2E 環境変数テンプレート
#
# コピーして .env にリネームして使う:
#   cp .env.example .env
#   # .env に実APIキーを記述 (この .env は gitignore 済み・コミットされない)
#
# ⚠️ 実APIキーをシェルに直接打つと bash/zsh 履歴に残るため、
#    必ずこの .env で管理し、以下のように読み込むこと:
#   set -a; source .env; set +a

# ── 実行モード ─────────────────────────────────────────────
# 1 にすると実APIモード (実際のプロバイダーに接続して AI 応答まで検証)
# 未設定/0 ならダミーモード (実API不要・UIフローのみ)
# DESKSPAWN_E2E_REAL=1

# ── API キー (実APIモード必須) ─────────────────────────────
# テストがこのキーをアプリに渡し、最終的に OS キーチェーンに保存される
# DESKSPAWN_API_KEY=sk-...

# ── 開発環境保護 ───────────────────────────────────────────
# E2E が実データを削除するためのガード (未設定だと reset_app_data が拒否)
# DESKSPAWN_TEST_RESET=1

# ═══════════════════════════════════════════════════════════
# プロバイダーごとの設定
# ═══════════════════════════════════════════════════════════
# ・標準プロバイダー (openai / anthropic / google 等) は
#   【プロバイダーID + APIキー + モデル】だけ。エンドポイントは不要 (SDKの既定値を使用)。
# ・custom / azure-openai / ollama / amazon-bedrock のみエンドポイント/リージョン追加。

# ── OpenAI ─────────────────────────────────────────────────
# DESKSPAWN_E2E_PROVIDER=openai
# DESKSPAWN_E2E_MODEL=gpt-4o-mini
# # エンドポイント不要

# ── Anthropic ──────────────────────────────────────────────
# DESKSPAWN_E2E_PROVIDER=anthropic
# DESKSPAWN_E2E_MODEL=claude-sonnet-4-20250514
# # エンドポイント不要

# ── custom (自前エンドポイント) ────────────────────────────
# DESKSPAWN_E2E_PROVIDER=custom
# DESKSPAWN_E2E_ENDPOINT=https://api.example.com/v1   # 必須
# DESKSPAWN_E2E_MODEL=my-model
# # エンドポイント必須 (SDKの既定値がないため)

# ── azure-openai ───────────────────────────────────────────
# DESKSPAWN_E2E_PROVIDER=azure-openai
# DESKSPAWN_E2E_ENDPOINT=https://<resource>.openai.azure.com/   # 必須
# DESKSPAWN_E2E_MODEL=<deployment-name>
# # エンドポイント必須 (Azure リソースURL)

# ── ollama ─────────────────────────────────────────────────
# DESKSPAWN_E2E_PROVIDER=ollama
# DESKSPAWN_E2E_ENDPOINT=http://localhost:11434   # 必須
# DESKSPAWN_E2E_MODEL=<model>
# # エンドポイント必須・APIキー不要 (NEEDS_API_KEY=false)

# ── amazon-bedrock ─────────────────────────────────────────
# DESKSPAWN_E2E_PROVIDER=amazon-bedrock
# DESKSPAWN_E2E_REGION=us-east-1
# DESKSPAWN_E2E_MODEL=<model-id>
# # リージョン必須・エンドポイント不要 (AWS 認証は別経路)

# ── テスト用キーチェーン分離 (ダミーモードのみ) ────────────
# 実APIモードでは本番キーチェーンを使う為、通常は設定しない。
# ダミーモードで本番キーを汚さない検証をする時に設定する:
#   DESKSPAWN_KEYCHAIN_SERVICE=com.deskspawn.e2e
