# DeskSpawn E2E 環境変数テンプレート
#
# コピーして .env にリネームして使う:
#   cp .env.example .env
#   # .env に実APIキーを記述 (この .env は gitignore 済み・コミットされない)
#
# ⚠️ 実APIキーをシェルに直接打つと bash/zsh 履歴に残るため、
#    必ずこの .env で管理し、以下のように読み込むこと:
#   set -a; source .env; set +a
#   または: export $(grep -v '^#' .env | xargs)

# ── 実行モード ─────────────────────────────────────────────
# 1 にすると実APIモード (実際のプロバイダーに接続して AI 応答まで検証)
# 未設定/0 ならダミーモード (実API不要・UIフローのみ)
# DESKSPAWN_E2E_REAL=0

# ── プロバイダー設定 (実APIモードで使用) ───────────────────
# DESKSPAWN_E2E_PROVIDER=custom
# DESKSPAWN_E2E_ENDPOINT=https://api.example.com/v1
# DESKSPAWN_E2E_MODEL=my-model
# DESKSPAWN_E2E_REGION=us-east-1   # amazon-bedrock のみ

# ── API キー (実APIモード必須・ダミーモード不要) ────────────
# 値は OS キーチェーンに保存される (本番と同じ経路)
# DESKSPAWN_API_KEY=sk-...

# ── 開発環境保護 (E2E が実データを削除するためのガード) ────
# 1 を設定しないと reset_app_data が拒否される
# DESKSPAWN_TEST_RESET=1

# ── テスト用キーチェーン分離 ───────────────────────────────
# 実APIモードでは本番キーチェーンを使いたい為、通常は設定しない。
# ダミーモードで本番キーを汚さない検証をする時に設定する:
#   DESKSPAWN_KEYCHAIN_SERVICE=com.deskspawn.e2e
